@server_host = https://localhost:7137

# Start the backend with:
# dotnet run --project PerfectTimetable.Server --launch-profile https

### Load the saved course model
GET {{server_host}}/timetable
Accept: application/json

### Generate timetables from a self-contained sample (does not save changes)
# Each block is 30 minutes; startBlock 1 is 08:00.
# This example has three valid combinations; the overlapping Monday pair is excluded.
POST {{server_host}}/timetable/generate
Content-Type: application/json
Accept: application/json

{
  "model": {
    "startTime": "08:00:00",
    "blockDuration": "00:30:00",
    "blocks": 16,
    "days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "courses": [
      {
        "id": 1,
        "name": "Programming",
        "durationBlocks": 2,
        "timeslots": [
          { "day": "Monday", "startBlock": 1 },
          { "day": "Tuesday", "startBlock": 1 }
        ]
      },
      {
        "id": 2,
        "name": "Mathematics",
        "durationBlocks": 2,
        "timeslots": [
          { "day": "Monday", "startBlock": 2 },
          { "day": "Tuesday", "startBlock": 3 }
        ]
      }
    ]
  }
}
