{
  "openapi": "3.0.1",
  "info": {
    "title": "PerfectTimetable.Server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7137/"
    }
  ],
  "paths": {
    "/timetable": {
      "get": {
        "tags": [
          "Timetable"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              }
            }
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Course": {
        "required": [
          "id",
          "name",
          "durationBlocks",
          "timeslots"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "durationBlocks": {
            "type": "integer",
            "format": "int32"
          },
          "timeslots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSlot"
            }
          }
        }
      },
      "CourseModel": {
        "required": [
          "courses",
          "days",
          "startTime",
          "blockDuration",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOfWeek"
            }
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "blockDuration": {
            "type": "string",
            "format": "time"
          },
          "blocks": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DayOfWeek": {
        "type": "integer"
      },
      "TimeSlot": {
        "required": [
          "day",
          "startBlock"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "integer",
            "format": "int32"
          },
          "startBlock": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32"
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Timetable"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}