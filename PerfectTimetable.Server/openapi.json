{
  "openapi": "3.0.1",
  "info": {
    "title": "PerfectTimetable.Server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7137/"
    }
  ],
  "paths": {
    "/timetable": {
      "get": {
        "tags": [
          "Timetable"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              }
            }
          }
        }
      }
    },
    "/timetable/generate": {
      "post": {
        "tags": [
          "Timetable"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateTimetableRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateTimetableRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateTimetableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Timetable"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Timetable"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Timetable"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timetable/applyModelOptions": {
      "post": {
        "tags": [
          "Timetable"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPropertiesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPropertiesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPropertiesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseModel"
                }
              }
            }
          }
        }
      }
    },
    "/timetable/aiCourse": {
      "post": {
        "tags": [
          "Timetable"
        ],
        "operationId": "AICourseRequest",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "ModelJson": {
                    "type": "string"
                  },
                  "Image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AICourseResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AICourseResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AICourseResponseDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AICourseResponseDto": {
        "required": [
          "course",
          "failedSlots"
        ],
        "type": "object",
        "properties": {
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "failedSlots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BlockLengthFilter": {
        "required": [
          "maxBlockLength"
        ],
        "type": "object",
        "properties": {
          "maxBlockLength": {
            "type": "integer",
            "format": "int32"
          }
        },
        "nullable": true
      },
      "Course": {
        "required": [
          "id",
          "name",
          "durationBlocks",
          "timeslots"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "durationBlocks": {
            "type": "integer",
            "format": "int32"
          },
          "timeslots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSlot"
            }
          }
        }
      },
      "CourseModel": {
        "required": [
          "courses",
          "days",
          "startTime",
          "blockDuration",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "maxCourses": {
            "type": "integer",
            "format": "int32"
          },
          "maxSlots": {
            "type": "integer",
            "format": "int32"
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimetableDay"
            }
          },
          "startTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "blockDuration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "blocks": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DistanceScoring": {
        "type": "object",
        "properties": {
          "differentDayScore": {
            "type": "integer",
            "format": "int32",
            "default": 8
          },
          "slotDistanceMultiplier": {
            "type": "integer",
            "format": "int32",
            "default": 2
          }
        },
        "nullable": true
      },
      "GenerateTimetableRequest": {
        "required": [
          "model"
        ],
        "type": "object",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/CourseModel"
          },
          "scoring": {
            "$ref": "#/components/schemas/DistanceScoring"
          },
          "filter": {
            "$ref": "#/components/schemas/BlockLengthFilter"
          }
        }
      },
      "ModelPropertiesRequest": {
        "required": [
          "model",
          "startTime",
          "blockDuration",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/CourseModel"
          },
          "startTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "blockDuration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "blocks": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TimeSlot": {
        "required": [
          "day",
          "startBlock"
        ],
        "type": "object",
        "properties": {
          "day": {
            "$ref": "#/components/schemas/TimetableDay"
          },
          "startBlock": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Timetable": {
        "required": [
          "slots",
          "score"
        ],
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimetableSlot"
            }
          },
          "score": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TimetableDay": {
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ]
      },
      "TimetableSlot": {
        "required": [
          "course",
          "timeSlot"
        ],
        "type": "object",
        "properties": {
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "timeSlot": {
            "$ref": "#/components/schemas/TimeSlot"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Timetable"
    }
  ]
}