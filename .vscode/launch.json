{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PerfectTimetable Server (https)",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project PerfectTimetable.Server --launch-profile https",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/perfecttimetable.client",
        "killOnServerStop": true
      }
    }
  ]
}
