{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PerfectTimetable Server (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/PerfectTimetable.Server/bin/Debug/net9.0/PerfectTimetable.Server.dll",
      "cwd": "${workspaceFolder}/PerfectTimetable.Server",
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/perfecttimetable.client",
        "killOnServerStop": true
      }
    }
  ]
}
